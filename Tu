from midiutil import MIDIFile

# Crear un archivo MIDI con 2 pistas
midi = MIDIFile(2)
midi.addTempo(0, 0, 60)  # pista 0 (piano)
midi.addTempo(1, 0, 60)  # pista 1 (violín)

# Acordes del intro (cada nota dura 2 beats)
piano_chords = [
    (["D3", "F3", "A3"], 0),
    (["A2", "C#3", "E3"], 2),
    (["Bb2", "D3", "F3"], 4),
    (["F2", "A2", "C3"], 6),
    (["G2", "Bb2", "D3"], 8),
    (["A2", "C#3", "E3"], 10),
    (["D3", "F3", "A3"], 12),
]

for chord_notes, start_time in piano_chords:
    for note_name in chord_notes:
        pitch = MIDIFile().noteToMidi(note_name)
        midi.addNote(0, 0, pitch, start_time, 2, 80)

# Melodía de violín (1 beat por nota)
melody = [
    "D5", "F5", "G5", "A5", "Bb5", "A5", "G5", "F5",
    "E5", "G5", "F5", "D5", "C#5", "D5",
    "F5", "E5", "D5", "C#5", "Bb4", "A4"
]
start = 14
for note_name in melody:
    pitch = MIDIFile().noteToMidi(note_name)
    midi.addNote(1, 0, pitch, start, 1, 90)
    start += 1

with open("Ultima_Luz_Nocturno.mid", "wb") as out:
    midi.writeFile(out)

print("MIDI generado: Ultima_Luz_Nocturno.mid")
